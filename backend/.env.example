# ===== 环境 =====
# dev | prod。设为 prod 会启用硬性校验：API_KEY 不能是默认值且至少 24 字符、
# CORS 不能含 * 或 localhost。不满足直接拒绝启动。
ENVIRONMENT=dev

# ===== 鉴权 =====
API_KEY=dev-local-api-key-change-me

# 允许跨域的前端来源(JSON 数组)。生产必须改成真实域名。
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== LLM 提供商: ollama | qwen =====
LLM_PROVIDER=ollama
# 单次 LLM 调用超时(秒)。一轮对话串联多次调用，慢机器上需放宽。
LLM_TIMEOUT_SECONDS=90
# 启动后在后台发一次极小探测调用预热模型。本地 Ollama 首次对话实测 115s，
# 预热后降到 1s 量级。预热失败不影响服务启动，只是失去"提前"的收益。
WARMUP_LLM=true

# 本地 Ollama (OpenAI 兼容接口)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=qwen2.5:7b

# 云端千问 (DashScope OpenAI 兼容模式)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
# RAGAS 风格评估的裁判模型：固定用云端强模型，与 LLM_PROVIDER 无关。
# 跑 scripts/eval_ragas.py 才需要；本地 7B 自评自己生成的答案不可信。
QWEN_JUDGE_MODEL=qwen-max
# 沉淀质量初筛（去重后打分）：成本优先，不追求裁判级准确度。
# 未配置时自动降级为纯人工审核，不影响"标记"功能本身。
QWEN_SEDIMENTATION_MODEL=qwen-plus

# ===== Embedding 提供商: ollama | qwen =====
# 默认 ollama 保证开箱即用(无需任何云端 Key)。
# 6G 显存机器建议改成 qwen 走云端 Embedding, 本地只留 rerank,
# 切换时必须同时填写上面的 QWEN_API_KEY, 否则启动校验会拦下。
# 注意: 切换 Embedding 提供商会因维度不同启用另一个 Qdrant 集合, 需重新灌库。
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIM=1024
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIM=1024

# ===== Rerank (本地 BGE) =====
# 需要额外安装: uv pip install -r pyproject.toml --extra rerank
# 未安装时检索链路自动降级为 RRF 融合顺序，不会报错中断。
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_USE_FP16=true
RERANK_TOP_N=5
# auto / cuda / cpu。auto 会在有 CUDA 时用 GPU；显存吃紧改 cpu(fp16 自动关闭)
RERANK_DEVICE=auto
# 启动后在后台预加载模型。关掉的话首次对话要多等十几秒(冷启动+HF 版本校验)
WARMUP_RERANKER=true

# ===== 向量库 (Qdrant embedded) =====
QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION_PREFIX=kb

# ===== 数据库 =====
DATABASE_URL=sqlite:///./data/app.db
# SQLite 写锁等待窗口(ms)。WAL 下写-写仍互斥，不设此值并发写会直接抛
# "database is locked"。一轮对话有多次写入(会话/消息/审计)，给足等待时间。
SQLITE_BUSY_TIMEOUT_MS=10000
# WAL 自动 checkpoint 页数阈值。WAL 文件靠 checkpoint 回收，不设会无限增长。
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# ===== RAG 检索 =====
CHUNK_STRATEGY=markdown
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=10
ENABLE_HYBRID_RETRIEVE=true
ENABLE_QUERY_REWRITE=true
RRF_K=60

# ===== Agent =====
AGENT_MAX_STEPS=6
TOOL_CACHE_TTL_SECONDS=300

# ===== 多轮上下文 =====
CONTEXT_WINDOW_TURNS=6
ENABLE_CONTEXT_SUMMARY=true

# ===== 安全 =====
MAX_INPUT_LENGTH=2000

# ===== 运行环境: dev | prod =====
ENVIRONMENT=dev

# 启动时是否真实探测 LLM/Embedding/Rerank 连通性。
# 本地模型冷启动可能耗时数十秒，开发阶段建议 false，上线前置 true。
STARTUP_PROBE_EXTERNAL=false
